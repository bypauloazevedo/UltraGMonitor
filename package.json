{
  "name": "ultragmonitor",
  "productName": "UltraGMonitor",
  "version": "0.1.0",
  "description": "Monitor de CPU, GPU, RAM, SSD, FPS, relógio e clima que fica num canto da tela",
  "author": "Paulo Azevedo",
  "license": "GPL-3.0-only",
  "repository": "github:bypauloazevedo/UltraGMonitor",
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "setup": "node scripts/fetch-deps.js && npm run build:sensor",
    "build:sensor": "node scripts/build-sensor.js",
    "icons": "electron scripts/make-icons.js",
    "dist": "node scripts/dist.js"
  },
  "dependencies": {
    "@fontsource-variable/doto": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/orbitron": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@fontsource-variable/oxanium": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/audiowide": "^5.3.0",
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/press-start-2p": "^5.3.0",
    "@fontsource/rajdhani": "^5.3.0",
    "@fontsource/share-tech-mono": "^5.3.0",
    "@fontsource/sixtyfour": "^5.3.0",
    "@fontsource/vt323": "^5.3.0"
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "dev.paulo.ultragmonitor",
    "productName": "UltraGMonitor",
    "directories": {
      "output": ".build",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "node_modules/@fontsource-variable/**/*",
      "node_modules/@fontsource/**/*"
    ],
    "extraResources": [
      {
        "from": "sensor/out",
        "to": "sensor"
      },
      {
        "from": "resources/presentmon",
        "to": "presentmon"
      },
      {
        "from": "resources/pawnio",
        "to": "pawnio"
      },
      {
        "from": "resources/setup",
        "to": "setup"
      }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "UltraGMonitor",
      "runAfterFinish": true,
      "include": "build/installer.nsh",
      "artifactName": "${productName}-Setup.${ext}",
      "installerLanguages": ["pt_BR"],
      "language": "1046"
    }
  }
}
