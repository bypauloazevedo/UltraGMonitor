{
  "name": "ultragmonitor",
  "productName": "UltraGMonitor",
  "version": "0.6.0",
  "description": "Monitor de CPU, GPU, RAM, SSD, FPS, relógio e clima que fica num canto da tela",
  "author": "Paulo Azevedo",
  "license": "GPL-3.0-only",
  "repository": "github:bypauloazevedo/UltraGMonitor",
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/prepare-ocr.js",
    "prepare:ocr": "node scripts/prepare-ocr.js",
    "test": "node --test tests/*.test.js",
    "test:ui": "node scripts/check-ui.js",
    "start": "electron .",
    "atalho:teste": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/create-test-shortcut.ps1",
    "setup": "node scripts/fetch-deps.js && npm run build:sensor && npm run build:keyboard",
    "build:keyboard": "node scripts/build-keyboard.js",
    "build:sensor": "node scripts/build-sensor.js",
    "icons": "electron scripts/make-icons.js",
    "dist": "node scripts/dist.js"
  },
  "dependencies": {
    "@fontsource-variable/doto": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/orbitron": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@fontsource-variable/oxanium": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/audiowide": "^5.3.0",
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/press-start-2p": "^5.3.0",
    "@fontsource/rajdhani": "^5.3.0",
    "@fontsource/share-tech-mono": "^5.3.0",
    "@fontsource/sixtyfour": "^5.3.0",
    "@fontsource/vt323": "^5.3.0"
  },
  "devDependencies": {
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/por": "1.0.0",
    "@tesseract.js-data/spa": "1.0.0",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "pngjs": "7.0.0",
    "tesseract.js": "7.0.0"
  },
  "build": {
    "appId": "dev.paulo.ultragmonitor",
    "productName": "UltraGMonitor",
    "extraResources": [
      {
        "from": "resources/ocr",
        "to": "ocr"
      },
      {
        "from": "resources/ocr/node_modules",
        "to": "ocr/node_modules"
      }
    ],
    "directories": {
      "output": ".build",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "node_modules/@fontsource-variable/**/*",
      "node_modules/@fontsource/**/*"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": "nsis",
      "extraResources": [
        {
          "from": "keyboard/out",
          "to": "keyboard"
        },
        {
          "from": "sensor/out",
          "to": "sensor"
        },
        {
          "from": "resources/presentmon",
          "to": "presentmon"
        },
        {
          "from": "resources/pawnio",
          "to": "pawnio"
        },
        {
          "from": "resources/setup",
          "to": "setup"
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/icon.png",
      "category": "Utility",
      "executableName": "ultragmonitor",
      "maintainer": "Paulo Azevedo",
      "synopsis": "Monitor de hardware, relógio, clima, captura de tela e gravação de vídeo",
      "artifactName": "${productName}-linux-${arch}.${ext}",
      "desktop": {
        "entry": {
          "StartupWMClass": "UltraGMonitor"
        }
      }
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "UltraGMonitor",
      "uninstallDisplayName": "${productName}",
      "runAfterFinish": true,
      "include": "build/installer.nsh",
      "artifactName": "${productName}-Setup.${ext}",
      "installerLanguages": [
        "pt_BR"
      ],
      "language": "1046"
    }
  }
}
